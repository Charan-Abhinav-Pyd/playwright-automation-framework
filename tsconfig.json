{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["config/**/*.ts", "fixtures/**/*.ts", "pages/**/*.ts", "reporters/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
